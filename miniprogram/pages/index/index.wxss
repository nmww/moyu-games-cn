.page {
  padding: 20rpx 24rpx 60rpx;
}
.hero {
  background: linear-gradient(135deg, #2b6cff, #5b8dff);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(43, 108, 255, 0.25);
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}
.hero-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.cat {
  margin: 36rpx 8rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  border-left: 8rpx solid #2b6cff;
  padding-left: 16rpx;
}
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 12rpx 20rpx;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
}
.card:active {
  transform: scale(0.96);
  background: #eef3ff;
}
.icon {
  font-size: 56rpx;
  line-height: 1.2;
}
.name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
}
.desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999;
}
.foot {
  text-align: center;
  color: #aaa;
  font-size: 22rpx;
  margin-top: 30rpx;
}
