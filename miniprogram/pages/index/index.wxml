<view class="page">
  <view class="hero">
    <view class="hero-title">🎮 cc 游戏厅</view>
    <view class="hero-sub">cc 出品 · 点击即玩</view>
  </view>

  <block wx:for="{{cats}}" wx:key="name">
    <view class="cat">{{item.name}}</view>
    <view class="grid">
      <view class="card"
            wx:for="{{item.list}}"
            wx:key="slug"
            wx:for-item="g"
            data-slug="{{g.slug}}"
            bindtap="open">
        <view class="icon">{{g.icon}}</view>
        <view class="name">{{g.name}}</view>
        <view class="desc">{{g.desc}}</view>
      </view>
    </view>
  </block>

  <view class="foot">共 {{cats.length}} 类 · 15 款精选小游戏</view>
</view>
